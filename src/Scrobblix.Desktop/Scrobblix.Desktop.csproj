<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\scrobblix.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ScrobblixUiQualification)' == 'true'">
    <DefineConstants>$(DefineConstants);SCROBBLIX_UI_QUALIFICATION</DefineConstants>
  </PropertyGroup>
  <!-- Optional automatic crash reporting (public ingest DSN, not a secret).
       Empty default keeps diagnostics local-only, matching the documented baseline. -->
  <PropertyGroup Condition="'$(SCROBBLIX_SENTRY_DSN)' != ''">
    <DefineConstants>$(DefineConstants);SCROBBLIX_SENTRY_DSN=%22$(SCROBBLIX_SENTRY_DSN)%22</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Scrobblix.Application/Scrobblix.Application.csproj" />
    <ProjectReference Include="../Scrobblix.Infrastructure/Scrobblix.Infrastructure.csproj" />
    <ProjectReference Include="../Scrobblix.Windows/Scrobblix.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Sentry" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
