<Window
    x:Class="Scrobblix.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scrobblix">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="16,24" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="AppBrandImage" Width="38" Height="38" Stretch="Uniform" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Scrobblix" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Listening companion" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <NavigationView x:Name="AppNavigationView" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" SelectionChanged="Navigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="home" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="History" Tag="history"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Statistics" Tag="statistics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Loved" Tag="loved"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Queue" Tag="queue"><NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Sources" Tag="sources"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Diagnostics" Tag="diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Settings" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
                </NavigationView.MenuItems>
            </NavigationView>
            <TextBlock Grid.Row="2" Text="Local listening data stays on this device." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer x:Name="HomeView" Grid.Column="1">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="See what Scrobblix can confirm about playback and delivery." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>

                <InfoBar x:Name="StartupInfo" IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="Starting Scrobblix"
                         Message="Preparing local listening history." />

                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="NOW PLAYING" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Grid Width="88" Height="88" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Top">
                                <Image x:Name="CurrentTrackArtworkFallback" Stretch="UniformToFill" />
                                <Image x:Name="CurrentTrackArtwork" Stretch="UniformToFill" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentTrackTitle" Text="Nothing playing" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="CurrentTrackDetail" Text="Listening for supported media through Windows media controls." TextWrapping="Wrap" />
                                <TextBlock x:Name="CurrentTrackSource" Text="Source: not detected" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Padding="16" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Scrobble eligibility" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ProgressBar x:Name="EligibilityProgressBar" Value="0" Maximum="100" />
                                <TextBlock x:Name="EligibilityDetailText" Text="Confirmed listening time is unavailable until a supported track is playing. Media position and confirmed listening time are tracked separately." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button x:Name="TrackingToggleButton" Content="Pause tracking" Click="TrackingToggleButton_Click" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="CurrentTrackLoveButton" Content="Love on Last.fm" Click="CurrentTrackLoveButton_Click" IsEnabled="False" />
                                    <Button x:Name="CurrentTrackUnloveButton" Content="Unlove on Last.fm" Click="CurrentTrackUnloveButton_Click" IsEnabled="False" />
                                </StackPanel>
                                <TextBlock x:Name="CurrentTrackLoveStatusText" Text="Connect Last.fm to manage loved tracks." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4"><TextBlock Text="Today" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Name="TodayStateText" Text="Loading local listening summary" /><TextBlock x:Name="TodayDetailText" Text="Confirmed listening time, eligibility, and accepted scrobbles will appear here." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4"><TextBlock Text="Queue" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Name="QueueStateText" Text="Queue not configured" /><TextBlock x:Name="QueueDetailText" Text="Pending, blocked, and failed provider actions will appear here." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6"><TextBlock Text="Last.fm" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Name="LastFmHomeStatusText" Text="Checking local connection state" TextWrapping="Wrap" /><TextBlock Text="Add API credentials and approve your account in Settings." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /><Button Content="Configure API key / Login" Click="OpenLastFmSettingsButton_Click" HorizontalAlignment="Left" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4"><TextBlock Text="Sources" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Checking Windows media controls" /><TextBlock x:Name="BrowserCompanionHomeStatusText" Text="Browser companion awaits packaged registration." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock Text="Recent activity" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Padding="16" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <StackPanel x:Name="RecentActivityList" Spacing="4"><TextBlock Text="No recent activity" /><TextBlock Text="Detected plays and provider outcomes will be listed here once tracking begins." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="HistoryView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Listening sessions kept locally on this device, including tracks that do not qualify for Last.fm." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="HistorySearchInput" PlaceholderText="Search artist, title, or album…" TextChanged="HistorySearchInput_TextChanged" />
                    <Button Grid.Column="1" Content="Export CSV" Click="ExportHistoryCsvButton_Click" />
                </Grid>
                <TextBlock x:Name="HistoryResultCountText" Text="Loading recent sessions…" Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel x:Name="HistoryList" Spacing="8">
                    <TextBlock Text="No listening sessions recorded yet." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StatisticsView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4"><TextBlock Text="Statistics" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Listening patterns calculated from local history and confirmed provider responses." Style="{StaticResource BodyTextBlockStyle}" /></StackPanel>
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Padding="20" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="Listening sessions" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="StatisticsSessionsText" Text="Loading…" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel></Border>
                    <Border Grid.Column="1" Padding="20" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="Confirmed listening" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="StatisticsListeningText" Text="Loading…" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel></Border>
                    <Border Grid.Row="1" Padding="20" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="Eligible sessions" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="StatisticsEligibleText" Text="Loading…" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel></Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="20" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="Accepted Last.fm scrobbles" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="StatisticsAcceptedText" Text="Loading…" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel></Border>
                </Grid>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12"><TextBlock Text="Top artists by confirmed listening time" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Calculated from local sessions; artists with missing metadata are excluded." Style="{StaticResource CaptionTextBlockStyle}" /><StackPanel x:Name="StatisticsTopArtistsList" Spacing="10"><TextBlock Text="No statistics yet." /></StackPanel></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="LovedView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Loved tracks" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Love and Unlove requests made from Scrobblix, including pending delivery and the latest provider result. This local view is not a complete sync of an existing remote loved library." Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="LovedPageStatusText" Text="Loading loved-track actions…" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel x:Name="LovedTracksList" Spacing="10">
                    <TextBlock Text="No Love/Unlove actions recorded yet." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="QueueView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Queue" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Actions are saved locally before delivery so they can be retried safely." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="QueuePageStateText" Text="Loading queue status" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="QueuePageDetailText" Text="Reading durable provider actions." TextWrapping="Wrap" />
                        <TextBlock Text="Last.fm delivery remains off until an account is configured. Local history is kept independently." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="Recent provider actions" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                        <TextBlock x:Name="QueuePageActionFeedbackText" Text="Actions can be retried or cancelled when their state permits." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel x:Name="QueuePageActionList" Spacing="10">
                            <TextBlock Text="No queue actions have been recorded yet." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SourcesView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Sources" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Playback is read from Windows media controls. Browser Companion is optional." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Windows media controls" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Active and future supported media sessions are checked while tracking is running." TextWrapping="Wrap" />
                        <TextBlock Text="Browser Companion" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock x:Name="BrowserCompanionSourceStatusText" Text="Optional. The app is listening for the native host, but packaged browser registration is not installed yet." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DiagnosticsView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Local status only. No listening metadata is uploaded from this page." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Current observation" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="DiagnosticsPlaybackText" Text="No supported playback has been observed yet." TextWrapping="Wrap" />
                        <TextBlock Text="Local event log" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock x:Name="LogDirectoryText" Text="Log directory is being prepared." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Button Content="Open log folder" Click="OpenLogFolderButton_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="Each entry has a sequential number and UTC timestamp. Credentials, authorization tokens and session keys are excluded from diagnostics." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="Recommendation" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Start a track in a Windows media-control-enabled app. If metadata stays incomplete, install the optional Browser Companion for that supported site." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Configuration stays local to this Windows account." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Last.fm API credentials" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Create an API application at last.fm/api/account/create. Enter the key and shared secret here; Scrobblix stores them in Windows Credential Locker. Never add the secret to Git." TextWrapping="Wrap" />
                        <TextBox x:Name="LastFmApiKeyInput" Header="API key" PlaceholderText="Paste your Last.fm API key" MaxLength="128" />
                        <PasswordBox x:Name="LastFmApiSecretInput" Header="Shared secret" PlaceholderText="Paste your Last.fm shared secret" MaxLength="128" />
                        <Button x:Name="SaveLastFmCredentialsButton" Content="Save API credentials securely" Click="SaveLastFmCredentialsButton_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LastFmCredentialsStatusText" Text="API credentials are not configured." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="Last.fm account" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="LastFmStatusText" Text="Not connected. A user-approved Last.fm account is required before Scrobblix can submit anything remotely." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConnectLastFmButton" Content="Connect Last.fm" Click="ConnectLastFmButton_Click" />
                            <Button x:Name="CompleteLastFmButton" Content="Finish approval" Click="CompleteLastFmButton_Click" IsEnabled="False" />
                            <Button x:Name="DisconnectLastFmButton" Content="Disconnect" Click="DisconnectLastFmButton_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="Privacy" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Local listening history stays on this device. Telemetry is off by default." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Background and notification area" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Minimizing Scrobblix hides its window in the Windows notification area while playback tracking and the durable queue keep running. Double-click the tray icon to reopen Scrobblix; right-click it to open or explicitly exit the app." TextWrapping="Wrap" />
                        <TextBlock Text="If the notification-area icon cannot be created on this PC, Scrobblix keeps running as a normal window and records the reason in Diagnostics." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Local data backup and restore" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Create a consistent SQLite snapshot you can keep offline. Restore is staged, Scrobblix closes, and the backup is applied on the next launch after an automatic safety snapshot." TextWrapping="Wrap" />
                        <TextBlock Text="Backup archives include local listening history and queue records only. Last.fm API secrets, session keys, and cached artwork are not exported." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CreateBackupButton" Content="Create backup…" Click="CreateBackupButton_Click" />
                            <Button x:Name="RestoreBackupButton" Content="Restore backup…" Click="RestoreBackupButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="DataManagementStatusText" Text="No backup operation has been run this session." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
