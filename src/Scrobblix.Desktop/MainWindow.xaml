<Window
    x:Class="Scrobblix.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scrobblix">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="16,24" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="AppBrandImage" Width="38" Height="38" Stretch="Uniform" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Scrobblix" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Listening companion" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
            <NavigationView x:Name="AppNavigationView" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" SelectionChanged="Navigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="home" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="History" Tag="history"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Statistics" Tag="statistics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Loved" Tag="loved"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Queue" Tag="queue"><NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Sources" Tag="sources"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Diagnostics" Tag="diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
                    <NavigationViewItem Content="Settings" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
                </NavigationView.MenuItems>
            </NavigationView>
            <TextBlock Grid.Row="2" Text="Local listening data stays on this device." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer x:Name="HomeView" Grid.Column="1">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1000" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Listening" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Playback, confirmed listening, eligibility, and provider delivery are separate states." Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="StartupInfo" IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="Preparing playback"
                         Message="Preparing local listening history." />

                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="NOW PLAYING" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="112" Height="112" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Top">
                                <Image x:Name="CurrentTrackArtworkFallback" Stretch="UniformToFill" />
                                <Image x:Name="CurrentTrackArtwork" Stretch="UniformToFill" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentTrackTitle" Text="Nothing playing" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="CurrentTrackDetail" Text="Listening for supported media through Windows media controls." TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Image x:Name="CurrentTrackSourceLogo" Width="24" Height="24" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Current source logo" /><FontIcon x:Name="CurrentTrackSourceIcon" Glyph="&#xE189;" FontSize="16" AutomationProperties.Name="Detected playback source" /><TextBlock x:Name="CurrentTrackSource" Text="Source: not detected" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border Padding="16" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Scrobble eligibility" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ProgressBar x:Name="EligibilityProgressBar" Value="0" Maximum="100"
                                             AutomationProperties.Name="Confirmed listening progress toward scrobble eligibility"
                                             AutomationProperties.HelpText="Only confirmed listening time counts. Media position is separate." />
                                <TextBlock x:Name="ScrobbleStatusText" Text="Waiting for supported playback." Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="EligibilityDetailText" Text="Confirmed listening time is unavailable until a supported track is playing. Media position and confirmed listening time are tracked separately." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                <StackPanel Spacing="8">
                                    <Button x:Name="TrackingToggleButton" Content="Pause tracking" Click="TrackingToggleButton_Click" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CurrentTrackLoveButton" Content="Love" Click="CurrentTrackLoveButton_Click" IsEnabled="False" />
                                        <Button x:Name="CurrentTrackUnloveButton" Content="Remove love" Click="CurrentTrackUnloveButton_Click" IsEnabled="False" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="CurrentTrackLoveStatusText" Text="Connect Last.fm to manage loved tracks." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Last.fm delivery" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="LastFmHomeStatusText" Text="Checking Last.fm connection" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="LastFmHomeDetailText" Text="Add API credentials and approve your account in Settings." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Queue" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="QueueStateText" Text="Checking queued provider actions" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="QueueDetailText" Text="Pending, blocked, and failed provider actions will appear here." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button x:Name="OpenLastFmSettingsButton" Content="Configure Last.fm" Click="OpenLastFmSettingsButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Text="Today" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="TodayStateText" Text="Loading local listening summary" />
                    <TextBlock x:Name="TodayDetailText" Text="Confirmed listening time, eligibility, and accepted scrobbles will appear here." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Recent tracks" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Padding="16" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <StackPanel x:Name="RecentActivityList" Spacing="4">
                            <TextBlock Text="No recent activity" />
                            <TextBlock Text="Detected plays and provider outcomes will be listed here once tracking begins." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="HistoryView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Listening sessions kept locally on this device, including tracks that do not qualify for Last.fm." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="HistorySearchInput" PlaceholderText="Search artist, title, or album…" TextChanged="HistorySearchInput_TextChanged" />
                    <Button Grid.Column="1" Content="Export CSV" Click="ExportHistoryCsvButton_Click" />
                </Grid>
                <TextBlock x:Name="HistoryResultCountText" Text="Loading recent sessions…" Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel x:Name="HistoryList" Spacing="8">
                    <TextBlock Text="No listening sessions recorded yet." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="StatisticsView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4"><TextBlock Text="Statistics" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Listening patterns calculated from local history and confirmed provider responses." Style="{StaticResource BodyTextBlockStyle}" /></StackPanel>
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Padding="20" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="Listening sessions" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="StatisticsSessionsText" Text="Loading…" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel></Border>
                    <Border Grid.Column="1" Padding="20" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="Confirmed listening" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="StatisticsListeningText" Text="Loading…" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel></Border>
                    <Border Grid.Row="1" Padding="20" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="Eligible sessions" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="StatisticsEligibleText" Text="Loading…" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel></Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="20" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="Accepted Last.fm scrobbles" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="StatisticsAcceptedText" Text="Loading…" Style="{StaticResource TitleTextBlockStyle}" /></StackPanel></Border>
                </Grid>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12"><TextBlock Text="Top artists by confirmed listening time" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Calculated from local sessions; artists with missing metadata are excluded." Style="{StaticResource CaptionTextBlockStyle}" /><StackPanel x:Name="StatisticsTopArtistsList" Spacing="10"><TextBlock Text="No statistics yet." /></StackPanel></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="LovedView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Loved tracks" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Love and Unlove requests made from Scrobblix, including pending delivery and the latest provider result. This local view is not a complete sync of an existing remote loved library." Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="LovedPageStatusText" Text="Loading loved-track actions…" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel x:Name="LovedTracksList" Spacing="10">
                    <TextBlock Text="No Love/Unlove actions recorded yet." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="QueueView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Queue" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Actions are saved locally before delivery so they can be retried safely." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="QueuePageStateText" Text="Loading queue status" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="QueuePageDetailText" Text="Reading durable provider actions." TextWrapping="Wrap" />
                        <TextBlock Text="Last.fm delivery remains off until an account is configured. Local history is kept independently." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="Recent provider actions" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                        <TextBlock x:Name="QueuePageActionFeedbackText" Text="Actions can be retried or cancelled when their state permits." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel x:Name="QueuePageActionList" Spacing="10">
                            <TextBlock Text="No queue actions have been recorded yet." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SourcesView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Sources" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Playback is read from Windows media controls. Browser Companion is optional." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Observed source" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Image x:Name="SourceIdentityLogo" Width="36" Height="36" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Observed source logo" />
                            <FontIcon x:Name="SourceIdentityIcon" Glyph="&#xE189;" FontSize="24" AutomationProperties.Name="Observed source" />
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock x:Name="SourceIdentityNameText" Text="No source detected" Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock x:Name="SourceIdentityStateText" Text="Waiting for an actual playback observation." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="SourceHealthSummaryText" Text="No playback observation received this session." TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="SourceLastObservationText" Text="The most recently observed source and event time will appear here." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="Windows media controls" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Detects the application identity exposed by Windows media controls. A recent observation proves an event was received; it does not certify continuous tracking during sleep or disconnection." TextWrapping="Wrap" />
                        <TextBlock Text="Browser Companion" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock x:Name="BrowserCompanionSourceStatusText" Text="Optional. Waiting for an event from an installed and registered browser extension; manifest files alone do not prove connectivity." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DiagnosticsView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Local status only. No listening metadata is uploaded from this page." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Current observation" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="DiagnosticsPlaybackText" Text="No supported playback has been observed yet." TextWrapping="Wrap" />
                        <TextBlock Text="Local event log" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock x:Name="LogDirectoryText" Text="Log directory is being prepared." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Button Content="Open log folder" Click="OpenLogFolderButton_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="Each entry has a sequential number and UTC timestamp. Credentials, authorization tokens and session keys are excluded from diagnostics." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="Privacy-safe support bundle" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Export a small ZIP with version details and operational event timestamps/categories. Free-form log messages, track history, artwork, full URLs and credentials are not included. Nothing is uploaded automatically." TextWrapping="Wrap" />
                        <Button x:Name="ExportSupportBundleButton" Content="Export support bundle…" Click="ExportSupportBundleButton_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="SupportBundleStatusText" Text="No support bundle has been created this session." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="Recommendation" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Start a track in a Windows media-control-enabled app. If metadata stays incomplete, install the optional Browser Companion for that supported site." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Configuration stays local to this Windows account. Advanced controls are hidden until needed." Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Choose the navigation density that suits your workspace. Narrow windows automatically use compact navigation; your saved preference returns when space permits." TextWrapping="Wrap" />
                        <CheckBox x:Name="CompactNavigationCheckBox" Content="Prefer compact navigation" IsChecked="False" Checked="CompactNavigationCheckBox_Changed" Unchecked="CompactNavigationCheckBox_Changed" AutomationProperties.HelpText="Save the rail preference for wide windows. Narrow windows use compact navigation automatically." />
                        <TextBlock x:Name="NavigationPreferenceStatusText" Text="Expanded navigation is used on wide windows by default." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Last.fm" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="API credentials" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="Create an API application at last.fm/api/account/create. Enter the key and shared secret here; Scrobblix stores them in Windows Credential Locker. Never add the secret to Git." TextWrapping="Wrap" />
                        <TextBox x:Name="LastFmApiKeyInput" Header="API key" PlaceholderText="Paste your Last.fm API key" MaxLength="128" />
                        <PasswordBox x:Name="LastFmApiSecretInput" Header="Shared secret" PlaceholderText="Paste your Last.fm shared secret" MaxLength="128" />
                        <Button x:Name="SaveLastFmCredentialsButton" Content="Save API credentials securely" Click="SaveLastFmCredentialsButton_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LastFmCredentialsStatusText" Text="API credentials are not configured." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="Account connection" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="LastFmStatusText" Text="Not connected. A user-approved Last.fm account is required before Scrobblix can submit anything remotely." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConnectLastFmButton" Content="Connect Last.fm" Click="ConnectLastFmButton_Click" />
                            <Button x:Name="CompleteLastFmButton" Content="Finish approval" Click="CompleteLastFmButton_Click" IsEnabled="False" />
                            <Button x:Name="DisconnectLastFmButton" Content="Disconnect" Click="DisconnectLastFmButton_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock Text="Provider status is shown in text. The Last.fm mark remains absent until its required brand approval is documented." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Detection" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Windows media controls (GSMTC) are the default detection path. The optional Browser Companion adds page metadata where Windows does not expose a clear identity." TextWrapping="Wrap" />
                        <TextBlock Text="Source names use identities actually exposed by active observations. Unknown sources remain neutral; logo files are local-only and optional." TextWrapping="Wrap" />
                        <Button Content="Review playback sources" Click="OpenSourcesButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Notifications" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <CheckBox x:Name="DesktopNotificationsCheckBox" Content="Notify me when Last.fm accepts a scrobble or delivery needs attention" IsChecked="False" Checked="DesktopNotificationsCheckBox_Changed" Unchecked="DesktopNotificationsCheckBox_Changed" />
                        <TextBlock x:Name="DesktopNotificationsStatusText" Text="Windows notifications are off. Enable this option to receive delivery updates." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <CheckBox x:Name="NotificationTrackDetailsCheckBox" Content="Show artist and track title in notifications (off by default)" IsChecked="False" Checked="NotificationTrackDetailsCheckBox_Changed" Unchecked="NotificationTrackDetailsCheckBox_Changed" />
                        <TextBlock x:Name="NotificationPrivacyStatusText" Text="Notification track details are hidden. This applies to the lock screen and notification banners." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="A success notification is shown only after provider acceptance. Hiding track details is independent of enabling notifications." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Privacy" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Local listening history stays on this device. Telemetry is off by default." TextWrapping="Wrap" />
                        <TextBlock Text="Last.fm API credentials and session keys remain in Windows Credential Locker. Support bundles exclude the listening database, track metadata, artwork, credentials and full URLs. Nothing is uploaded automatically." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Storage" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Create a consistent SQLite snapshot you can keep offline. Restore is staged, Scrobblix closes, and the backup is applied on the next launch after an automatic safety snapshot." TextWrapping="Wrap" />
                        <TextBlock Text="Backup archives include local listening history and queue records only. Last.fm API secrets, session keys, and cached artwork are not exported." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CreateBackupButton" Content="Create backup…" Click="CreateBackupButton_Click" />
                            <Button x:Name="RestoreBackupButton" Content="Restore backup…" Click="RestoreBackupButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="DataManagementStatusText" Text="No backup operation has been run this session." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <Button x:Name="ToggleAdvancedDetailsButton" Content="Show advanced details" Click="ToggleAdvancedDetailsButton_Click" HorizontalAlignment="Left" AutomationProperties.HelpText="Show or hide extra local diagnostics guidance." />
                <Border x:Name="AdvancedSettingsDetails" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Advanced details" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Diagnostics provides local event logs, source observations, support-bundle export and operational explanations." TextWrapping="Wrap" />
                        <Button Content="Open Diagnostics" Click="OpenDiagnosticsButton_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="Playback tracking, eligibility, the durable queue and retry rules are independent of navigation layout." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
