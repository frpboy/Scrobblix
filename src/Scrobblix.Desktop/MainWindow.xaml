<Window
    x:Class="Scrobblix.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scrobblix">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="16,24" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Scrobblix" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Listening companion" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <NavigationView Grid.Row="1" PaneDisplayMode="LeftMinimal" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" SelectionChanged="Navigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="home" IsSelected="True" />
                    <NavigationViewItem Content="History" Tag="history" />
                    <NavigationViewItem Content="Statistics" IsEnabled="False" ToolTipService.ToolTip="Statistics are not available in this build." />
                    <NavigationViewItem Content="Loved" IsEnabled="False" ToolTipService.ToolTip="Loved tracks are not available in this build." />
                    <NavigationViewItem Content="Queue" Tag="queue" />
                    <NavigationViewItem Content="Sources" Tag="sources" />
                    <NavigationViewItem Content="Diagnostics" Tag="diagnostics" />
                    <NavigationViewItem Content="Settings" Tag="settings" />
                </NavigationView.MenuItems>
            </NavigationView>
            <TextBlock Grid.Row="2" Text="Local listening data stays on this device." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer x:Name="HomeView" Grid.Column="1">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="See what Scrobblix can confirm about playback and delivery." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>

                <InfoBar x:Name="StartupInfo" IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="Starting Scrobblix"
                         Message="Preparing local listening history." />

                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="NOW PLAYING" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border Width="88" Height="88" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Top">
                                <TextBlock Text="No artwork" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentTrackTitle" Text="Nothing playing" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="CurrentTrackDetail" Text="Listening for supported media through Windows media controls." TextWrapping="Wrap" />
                                <TextBlock x:Name="CurrentTrackSource" Text="Source: not detected" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Padding="16" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Scrobble eligibility" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ProgressBar x:Name="EligibilityProgressBar" Value="0" Maximum="100" />
                                <TextBlock x:Name="EligibilityDetailText" Text="Confirmed listening time is unavailable until a supported track is playing. Media position and confirmed listening time are tracked separately." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button x:Name="TrackingToggleButton" Content="Pause tracking" Click="TrackingToggleButton_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4"><TextBlock Text="Today" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="No summary available yet" /><TextBlock Text="Detected plays, accepted scrobbles, and listening time will appear here." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4"><TextBlock Text="Queue" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Name="QueueStateText" Text="Queue not configured" /><TextBlock x:Name="QueueDetailText" Text="Pending, blocked, and failed provider actions will appear here." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4"><TextBlock Text="Last.fm" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Not connected" /><TextBlock Text="Local history can continue without a provider account." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4"><TextBlock Text="Sources" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Checking Windows media controls" /><TextBlock Text="Browser Companion support is not configured in this build." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock Text="Recent activity" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Padding="16" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <StackPanel x:Name="RecentActivityList" Spacing="4"><TextBlock Text="No recent activity" /><TextBlock Text="Detected plays and provider outcomes will be listed here once tracking begins." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="HistoryView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Eligible plays kept locally on this device." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <StackPanel x:Name="HistoryList" Spacing="8">
                    <TextBlock Text="No eligible plays recorded yet." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="QueueView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Queue" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Actions are saved locally before delivery so they can be retried safely." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="QueuePageStateText" Text="Loading queue status" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="QueuePageDetailText" Text="Reading durable provider actions." TextWrapping="Wrap" />
                        <TextBlock Text="Last.fm delivery remains off until an account is configured. Local history is kept independently." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SourcesView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Sources" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Playback is read from Windows media controls. Browser Companion is optional." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Windows media controls" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Active and future supported media sessions are checked while tracking is running." TextWrapping="Wrap" />
                        <TextBlock Text="Browser Companion" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Optional. Install it only when a browser site needs more complete metadata than Windows supplies." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DiagnosticsView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Local status only. No listening metadata is uploaded from this page." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Current observation" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="DiagnosticsPlaybackText" Text="No supported playback has been observed yet." TextWrapping="Wrap" />
                        <TextBlock Text="Recommendation" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Start a track in a Windows media-control-enabled app. If metadata stays incomplete, install the optional Browser Companion for that supported site." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsView" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Padding="32" Spacing="24" MaxWidth="1200" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Configuration stays local to this Windows account." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Border Padding="24" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Last.fm" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Not connected. A user-approved Last.fm account is required before Scrobblix can submit anything remotely." TextWrapping="Wrap" />
                        <TextBlock Text="Privacy" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="Local listening history stays on this device. Telemetry is off by default." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
