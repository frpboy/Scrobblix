<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Scrobblix.Application/Scrobblix.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Sentry" Version="7.0.0" />
  </ItemGroup>
  <!-- Optional automatic crash reporting (public ingest DSN, not a secret): the
       SCROBBLIX_SENTRY_DSN environment variable is baked into generated source.
       An empty value keeps diagnostics local-only, matching the documented baseline. -->
  <Target Name="ScrobblixGenerateSentryDsn" BeforeTargets="CoreCompile">
    <!-- Strict validation instead of C# escaping: only URL-safe characters may
         be baked in, so the generated const needs no escaping at all. -->
    <Error Condition="'$(SCROBBLIX_SENTRY_DSN)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(SCROBBLIX_SENTRY_DSN)', '^[A-Za-z0-9:/.@_-]+$'))"
           Text="SCROBBLIX_SENTRY_DSN contains characters outside the URL-safe set; refusing to bake it into generated source." />
    <!-- Semicolons are MSBuild item separators in task attributes: %3B escapes them. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)ScrobblixSentryDsn.g.cs"
                      Lines="namespace Scrobblix.Windows%3B internal static class ScrobblixSentryDsn { public const string Value = &quot;$(SCROBBLIX_SENTRY_DSN)&quot;%3B }"
                      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ScrobblixSentryDsn.g.cs" />
    </ItemGroup>
  </Target>
</Project>
