{
  "manifest_version": 3,
  "name": "Scrobblix Browser Companion",
  "version": "0.1.0",
  "description": "Sends supported playback metadata to your local Scrobblix app.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Scrobblix Browser Companion",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "dist/service-worker.js"
    ],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "scrobblix@frpboy.in",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://open.spotify.com/*"
      ],
      "js": [
        "dist/media-observer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://music.youtube.com/*",
    "https://open.spotify.com/*"
  ]
}
